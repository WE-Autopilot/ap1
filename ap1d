#!/usr/bin/env bash
# ap1d - build and run AP1 module containers. See docker/README.md.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODULES=(perception)

usage() {
    cat <<'EOF'
Usage: ./ap1d <command> [module] [options]

Commands:
  build <module>     Build the module's image (deploy, or dev with --dev)
  up <module>        Build, then start the module's container in the background
                       deploy: runs the module's nodes
                       dev:    mounts src/<module> and waits for you to `shell` in
  shell <module>     Open a shell in the running dev container
  test <module>      Build the deploy image and run the module's smoke test in it
  e2e <module>       Build and start the module, then feed it test data over ROS
                     and check its output (perception: stop sign -> entity)
  logs <module>      Follow the module container's logs (started with `up`)
  down               Stop and remove all AP1 containers (keeps dev build volumes)

Modules: perception

Options:
  --gpu   Use the GPU image (needs an NVIDIA GPU + NVIDIA container toolkit).
          Export AP1_VARIANT=gpu in your shell rc to make it your default.
  --cpu   Use the CPU image (default).
  --dev   Use the dev image/container instead of the deploy one.

Examples:
  ./ap1d up perception --dev        # CPU dev container
  ./ap1d shell perception           # then: colcon build --symlink-install
  ./ap1d up perception --gpu        # run the YOLO node on the GPU
  ./ap1d e2e perception --gpu       # end-to-end test on the GPU
EOF
}

die() { echo "ap1d: $*" >&2; exit 1; }

# ---------------------------------------------------------------- arguments
[[ $# -ge 1 ]] || { usage; exit 1; }
COMMAND="$1"; shift
MODULE=""
DEV=false
VARIANT="${AP1_VARIANT:-cpu}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --gpu) VARIANT=gpu ;;
        --cpu) VARIANT=cpu ;;
        --dev) DEV=true ;;
        -h|--help) usage; exit 0 ;;
        -*) die "unknown option '$1' (see ./ap1d --help)" ;;
        *)  [[ -z "$MODULE" ]] || die "unexpected argument '$1'"; MODULE="$1" ;;
    esac
    shift
done

case "$VARIANT" in
    cpu) DEVICE=cpu ;;
    gpu) DEVICE=cuda ;;
    *) die "AP1_VARIANT must be 'cpu' or 'gpu', got '$VARIANT'" ;;
esac

require_module() {
    [[ -n "$MODULE" ]] || die "'$COMMAND' needs a module: ${MODULES[*]}"
    [[ " ${MODULES[*]} " == *" $MODULE "* ]] || die "unknown module '$MODULE' (available: ${MODULES[*]})"
}

# ---------------------------------------------------------------- helpers
export AP1_VARIANT="$VARIANT" AP1_DEVICE="$DEVICE"
# Containers run as the host user (see modules/docker-compose.yaml)
export AP1_UID="$(id -u)" AP1_GID="$(id -g)"
export AP1_REGISTRY="${AP1_REGISTRY:-ghcr.io/we-autopilot/ap1}"
# Keep ROS 2 discovery on this machine unless told otherwise, so people sharing
# a network (e.g. campus Wi-Fi) never see each other's topics. Containers use
# host networking, so they still reach each other and native nodes. Export
# ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET to talk to other machines (car, laptops).
export ROS_AUTOMATIC_DISCOVERY_RANGE="${ROS_AUTOMATIC_DISCOVERY_RANGE:-LOCALHOST}"
# ROS silently falls back to localhost-only on an invalid value (e.g. lowercase
# "subnet"), so fail here instead. Native nodes read the same variable from your
# shell, so it has to be fixed there, not just inside ap1d.
case "$ROS_AUTOMATIC_DISCOVERY_RANGE" in
    LOCALHOST|SUBNET|OFF|SYSTEM_DEFAULT) ;;
    *) die "ROS_AUTOMATIC_DISCOVERY_RANGE='$ROS_AUTOMATIC_DISCOVERY_RANGE' isn't valid (case matters).
  Use LOCALHOST, SUBNET, OFF or SYSTEM_DEFAULT, e.g.: export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET" ;;
esac

compose() {
    local files=(-f "$ROOT/modules/docker-compose.yaml" -f "$ROOT/modules/docker-compose.dev.yaml")
    [[ "$VARIANT" == gpu ]] && files+=(-f "$ROOT/modules/docker-compose.gpu.yaml")
    docker compose "${files[@]}" "$@"
}

service() { if $DEV; then echo "$MODULE-dev"; else echo "$MODULE"; fi; }

build() {
    docker buildx version > /dev/null 2>&1 \
        || die "docker buildx is missing (Arch: pacman -S docker-buildx, Ubuntu: apt install docker-buildx-plugin)"
    [[ -f "$ROOT/src/msgs/package.xml" ]] \
        || die "src/msgs (ap1_msgs) is missing. It is part of the repo: update your branch from main"
    local target="$MODULE-$VARIANT"
    $DEV && target="$MODULE-dev-$VARIANT"
    echo "ap1d: building $target"
    (cd "$ROOT" && USERNAME="$(id -un)" USER_UID="$AP1_UID" USER_GID="$AP1_GID" \
        REGISTRY="$AP1_REGISTRY" docker buildx bake -f docker/docker-bake.hcl --load "$target")
}

prepare_mounts() {
    mkdir -p "$ROOT/models" "$ROOT/bags"
    if [[ "$MODULE" == perception && ! -f "$ROOT/models/yolo11n.onnx" ]]; then
        die "models/yolo11n.onnx not found. Copy it in with:
  cp src/perception/ap1_perception/yolo/yolo11n.onnx models/"
    fi
}

# ---------------------------------------------------------------- commands
case "$COMMAND" in
    build)
        require_module
        build
        ;;
    up)
        require_module
        prepare_mounts
        build
        compose --profile "$(service)" up -d "$(service)"
        if $DEV; then
            echo "ap1d: dev container running. Open a shell with: ./ap1d shell $MODULE"
        else
            echo "ap1d: $MODULE running ($VARIANT, ROS discovery: $ROS_AUTOMATIC_DISCOVERY_RANGE). Follow logs with: ./ap1d logs $MODULE"
        fi
        ;;
    shell)
        require_module
        DEV=true
        compose --profile "$(service)" ps --status running -q "$(service)" | grep -q . \
            || die "dev container isn't running. Start it with: ./ap1d up $MODULE --dev"
        compose --profile "$(service)" exec "$(service)" bash
        ;;
    test)
        require_module
        DEV=false
        prepare_mounts
        build
        compose --profile "$MODULE" run --rm --no-deps \
            -v "$ROOT/docker/tests:/tests:ro" "$MODULE" \
            python3 "/tests/${MODULE}_smoke.py" --model /opt/ap1/models/yolo11n.onnx --device "$DEVICE"
        ;;
    e2e)
        require_module
        DEV=false
        [[ -f "$ROOT/docker/tests/${MODULE}_e2e.py" ]] || die "no end-to-end test for $MODULE yet"
        prepare_mounts
        build
        # Leave the module running afterwards only if it was running before
        was_running=false
        compose --profile "$MODULE" ps --status running -q "$MODULE" | grep -q . && was_running=true
        # Testing against a running module means testing it as it is: don't let
        # `up -d` below swap it for the other variant (e.g. GPU node, no --gpu here)
        if $was_running; then
            # The image name it was created from; `ps` shows a bare ID once the tag moves
            running_image="$(docker inspect -f '{{.Config.Image}}' \
                "$(compose --profile "$MODULE" ps -q "$MODULE")")"
            if [[ "$running_image" != "$AP1_REGISTRY/$MODULE:$VARIANT" ]]; then
                die "$MODULE is already running as '$running_image', not the $VARIANT variant.
  Use the same flag it was started with (e.g. ./ap1d e2e $MODULE --gpu), or ./ap1d down first."
            fi
        fi
        started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        compose --profile "$MODULE" up -d "$MODULE"
        # The test runs in a second container from the same image, acting as the
        # sensor driver; host networking puts both on the same ROS graph
        status=0
        compose --profile "$MODULE" run --rm --no-deps \
            -v "$ROOT/docker/tests:/tests:ro" "$MODULE" \
            python3 "/tests/${MODULE}_e2e.py" || status=$?
        # Show what the module logged during the test, before its container is removed
        echo
        echo "ap1d: $MODULE logs during the test:"
        compose --profile "$MODULE" logs --since "$started" "$MODULE"
        [[ $status -eq 0 ]] && echo "ap1d: e2e passed" || echo "ap1d: e2e FAILED"
        $was_running || compose --profile "$MODULE" rm --stop --force "$MODULE" > /dev/null 2>&1
        exit $status
        ;;
    logs)
        require_module
        # compose prints nothing (and succeeds) when there's no container, so say why
        if ! compose --profile "$(service)" ps -a -q "$(service)" | grep -q .; then
            if $DEV; then
                die "no $MODULE dev container. Start it with: ./ap1d up $MODULE --dev"
            fi
            die "no $MODULE container to show logs for. Start it with: ./ap1d up $MODULE
  ('test' and 'e2e' use temporary containers; their output prints while they run)"
        fi
        if $DEV; then
            echo "ap1d: the dev container only idles; nodes you start in './ap1d shell $MODULE' print there"
        elif ! compose --profile "$(service)" ps --status running -q "$(service)" | grep -q .; then
            echo "ap1d: $MODULE isn't running (it exited); showing its last logs"
        fi
        compose --profile "$(service)" logs -f "$(service)"
        ;;
    down)
        compose --profile "*" down
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        die "unknown command '$COMMAND' (see ./ap1d --help)"
        ;;
esac
