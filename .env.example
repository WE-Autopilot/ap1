# Copy to .env in the repository root for Docker Compose.
COMPOSE_FILE=modules/docker-compose.yaml:modules/docker-compose.dev.yaml

# Optional ROS settings. Match the domain and middleware of any peer nodes.
# ROS_DOMAIN_ID=0
# ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Optional image settings. Export AP1_REGISTRY in your shell for Bake as well.
# AP1_REGISTRY=ghcr.io/we-autopilot/ap1
# AP1_TAG_SUFFIX=
