repositories:
  # Source-built dependencies only. Everything else comes from apt via rosdep
  # (declared in each package.xml), e.g. GTSAM (ros-jazzy-gtsam, needed by
  # LIO-SAM) and Autoware NDT (ros-jazzy-autoware-ndt-scan-matcher, used by
  # ap1_localization). Both have amd64 and arm64 binaries.

  # SLAM / map building (Section 5.3). Pinned to a commit so every machine
  # builds the same code; ap1_setup.sh patches its CMakeLists for Jazzy.
  src/external/LIO-SAM:
    type: git
    url: https://github.com/TixiaoShan/LIO-SAM.git
    version: 08af3f32f01725372d4269838dc44c19c6d9e76b # ros2 branch, 2025-02-14

  src/msgs:
    type: git
    url: 'https://github.com/WE-Autopilot/ap1_msgs'
    version: main
