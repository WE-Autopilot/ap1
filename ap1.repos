repositories:
  # SLAM & Factor Graph Dependencies (Section 5.3)
  src/external/gtsam:
    type: git
    url: https://github.com/borglab/gtsam.git
    version: 4.2a9 # Use a stable tag recommended for ROS 2

  src/external/LIO-SAM:
    type: git
    url: https://github.com/TixiaoShan/LIO-SAM.git
    version: ros2 # Target the specific ROS 2 branch

  # Scan Matching Dependencies (Section 5.4)
  src/external/autoware_ndt:
    type: git
    url: https://github.com/autowarefoundation/autoware.universe.git
    version: main # Or pin to a specific stable Autoware release tag

  src/msgs:
    type: git
    url: 'https://github.com/WE-Autopilot/ap1_msgs'
    version: main

  src/external/tier4_autoware_msgs:
    type: git
    url: https://github.com/tier4/tier4_autoware_msgs.git
    version: tier4/universe